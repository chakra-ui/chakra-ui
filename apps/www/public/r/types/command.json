  "Root": {
    "props": {
      "loading": {
        "type": "boolean | undefined",
        "defaultValue": false,
        "isRequired": false,
        "description": "Whether the command palette is loading results. Shows the `Spinner` and\n`Loading` parts, and is reflected on the panel and indicator parts."
      },
      "hotkeys": {
        "type": "string[] | undefined",
        "defaultValue": [
          "mod+k"
        ],
        "isRequired": false,
        "description": "Keyboard shortcuts that toggle the palette. `mod` resolves to Command on\nmacOS and Control elsewhere."
      },
      "hotkeyOptions": {
        "type": "CommandHotkeyOptions | undefined",
        "isRequired": false,
        "description": "Options for the keyboard shortcuts."
      },
      "closeOnSelect": {
        "type": "boolean | undefined",
        "isRequired": false,
        "description": "Whether selecting an item closes the palette. Defaults to `true` in action\nmode and `false` in single and multiple selection modes."
      },
      "selectionMode": {
        "type": "\"none\" | \"single\" | \"multiple\" | undefined",
        "defaultValue": "none",
        "isRequired": false,
        "description": "How selection behaves. The default `none` runs commands without\npersisting a selected state; use `onSelect` to execute them. Pass\n`single` or `multiple` to build pickers where selection persists."
      },
      "as": {
        "type": "React.ElementType",
        "isRequired": false,
        "description": "The underlying element to render."
      },
      "asChild": {
        "type": "boolean",
        "isRequired": false,
        "description": "Use the provided child element as the default rendered element, combining their props and behavior."
      },
      "unstyled": {
        "type": "boolean",
        "isRequired": false,
        "description": "Whether to remove the component's style."
      },
      "size": {
        "type": "\"sm\" | \"md\" | \"lg\"",
        "defaultValue": "md",
        "isRequired": false,
        "description": "The size of the component"
      }
    }
  },
